{
	"schemaVersion": 1,
	"id": "mc-paint",
	"version": "${version}",
	"name": "MC Paint",
	"description": "Easels, canvases and dye palettes: paint pixel art by hand, sign it, and hang it on the wall (server-side with Pandorical)",
	"authors": [
		"justfatlard"
	],
	"contact": {
		"sources": "https://github.com/fatlard1993/mc-paint"
	},
	"license": "MIT",
	"icon": "assets/mc-paint/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"justfatlard.mc_paint.Main"
		]
	},
	"mixins": [
		"mc-paint.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"fabric-api": "${fabricApiVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25",
		"pandorical": ">=1.3.9"
	}
}
