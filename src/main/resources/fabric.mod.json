{
	"schemaVersion": 1,
	"id": "mc-paint",
	"version": "${version}",
	"name": "MC Paint",
	"description": "Easels and canvases to paint pixel art by hand and hang it up",
	"authors": [
		"justfatlard"
	],
	"contact": {
		"sources": "https://github.com/fatlard1993/mc-paint"
	},
	"license": "MIT",
	"icon": "assets/mc-paint/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"justfatlard.mc_paint.Main"
		]
	},
	"mixins": [
		"mc-paint.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"fabric-api": "${fabricApiVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25",
		"pandorical": ">=15.0.0"
	},
	"suggests": {
		"block-tip": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.donate": "https://github.com/sponsors/fatlard1993"
			}
		}
	}
}
